# Approved development/test Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-approved-test-project.supabase.co

# Publishable key for the same development/test project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-test-project-publishable-key

# Application origin for invitation and password-recovery links.
# Local development: http://localhost:3000
# Staging: https://staging.adebolacollege.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key for invitation and account-activation actions.
# Never expose this key to browser code or include a real value in a ZIP.
SUPABASE_SERVICE_ROLE_KEY=your-test-project-service-role-key

# Optional. Enable only when the matching account-archiving migration is installed.
SUB_ADMIN_ARCHIVING_ENABLED=false

# Server-only Resend API key for application transactional email.
RESEND_API_KEY=

# Verified sender address for application transactional email.
CONTACT_FROM_EMAIL=

# Explicit recipient for pending E-Learning order notifications.
E_LEARNING_ADMIN_EMAIL=
